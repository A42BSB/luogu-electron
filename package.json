{
  "name": "luogu-electron",
  "version": "1.0.2",
  "description": "洛谷非官方桌面客户端（Pre-Release）",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.a42bsb.luogu",
    "productName": "洛谷",
    "copyright": "Copyright © 2026 A42BSB",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "luogu.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "洛谷 Setup ${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}