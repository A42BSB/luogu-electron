{
  "name": "luogu-electron",
  "version": "1.0.2",
  "description": "洛谷非官方桌面客户端（Pre-Release）",
  "author": "A42Null",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder",
    "start": "electron ."
  },
  "build": {
    "appId": "com.a42null.luogu",
    "productName": "洛谷",
    "copyright": "Copyright © 2026 A42Null",
    "electronVersion": "43.3.0",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "tray-icon.ico",
      "executableName": "luogu"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "洛谷 Setup ${version}-${arch}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "A42Null",
      "repo": "luogu-electron"
    }
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}