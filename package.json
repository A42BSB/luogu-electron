{
  "name": "luogu-electron",
  "version": "1.0.2-pre.3",
  "description": "洛谷非官方桌面客户端（Pre-Release）",
  "author": "A42BSB",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.a42bsb.luogu",
    "productName": "洛谷",
    "copyright": "Copyright © 2026 A42BSB",
    "electronDist": ".\\electron-dist",
    "electronVersion": "43.2.0",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [{
        "target": "nsis",
        "arch": ["x64"]
      }],
      "icon": "luogu.ico",
      "executableName": "luogu"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "洛谷 Setup ${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "A42BSB",
      "repo": "luogu-electron"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}